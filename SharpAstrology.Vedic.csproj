<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SharpAstrology.Vedic</PackageId>
        <PackageTags>Astrology</PackageTags>
        <Version>0.4.0</Version>
        <PackageReleaseNotes>0.4.0: Every method now reads the zodiac of the chart instead of subtracting the ayanamsa unconditionally. A chart built with EphCalculationMode.Sidereal already carries sidereal longitudes, and taking the ayanamsa off a second time moved NakshatraOf, PadaOf and above all Dashas by about 24 degrees. The signatures are unchanged and a tropical chart gives the same answers as before. The floor on SharpAstrology.Base moved to 0.14.0, which is the version that lets a chart report its zodiac.</PackageReleaseNotes>
        <Authors>Christian Reizner</Authors>
        <IsPackable>true</IsPackable>
        <Description>
            This package provides enums and data types that are fundamental to Vedic astrological systems.
            It extends the AstrologyChart class for Vedic astrology purposes.
        </Description>
        <RepositoryUrl>https://github.com/CReizner/SharpAstrology.Vedic</RepositoryUrl>
        <PackageProjectUrl>https://github.com/CReizner/SharpAstrology.Vedic</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="$(PackageReadmeFile)"/>
    </ItemGroup>

    <PropertyGroup>
        <SharpAstrologyBaseVersion>[0.14.0,)</SharpAstrologyBaseVersion>
    </PropertyGroup>

    <ItemGroup Condition="Exists('..\SharpAstrology.Base\SharpAstrology.Base.csproj')">
        <ProjectReference Include="..\SharpAstrology.Base\SharpAstrology.Base.csproj" />
    </ItemGroup>

    <ItemGroup Condition="!Exists('..\SharpAstrology.Base\SharpAstrology.Base.csproj')">
        <PackageReference Include="SharpAstrology.Base" Version="$(SharpAstrologyBaseVersion)" />
    </ItemGroup>

</Project>
