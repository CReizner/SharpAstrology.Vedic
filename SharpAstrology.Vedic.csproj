<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SharpAstrology.Vedic</PackageId>
        <PackageTags>Astrology</PackageTags>
        <Version>0.3.0</Version>
        <Authors>Christian Reizner</Authors>
        <IsPackable>true</IsPackable>
        <Description>
            This package provides enums and data types that are fundamental to Vedic astrological systems.
            It extends the AstrologyChart class for Vedic astrology purposes.
        </Description>
        <RepositoryUrl>https://github.com/CReizner/SharpAstrology.Vedic</RepositoryUrl>
        <PackageProjectUrl>https://github.com/CReizner/SharpAstrology.Vedic</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="$(PackageReadmeFile)"/>
    </ItemGroup>

    <!-- The floor is only used in a clone of this repository alone, where the sibling project
         is missing. Packing from the full working copy takes the version of the referenced
         project instead, so the floor is kept at the version that project currently has.
         Both ways then produce the same dependency. -->
    <PropertyGroup>
        <SharpAstrologyBaseVersion>[0.13.0,)</SharpAstrologyBaseVersion>
    </PropertyGroup>

    <ItemGroup Condition="Exists('..\SharpAstrology.Base\SharpAstrology.Base.csproj')">
        <ProjectReference Include="..\SharpAstrology.Base\SharpAstrology.Base.csproj" />
    </ItemGroup>

    <ItemGroup Condition="!Exists('..\SharpAstrology.Base\SharpAstrology.Base.csproj')">
        <PackageReference Include="SharpAstrology.Base" Version="$(SharpAstrologyBaseVersion)" />
    </ItemGroup>

</Project>
